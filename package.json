{
  "name": "dsh-desktop",
  "version": "0.1.9",
  "description": "macOS desktop app for DeepSeek Harness: wraps the web UI, keeps the GitHub source updated, and manages community plugins.",
  "main": "main.js",
  "homepage": "https://github.com/deepseek-ai/deepseek-harness",
  "scripts": {
    "start": "electron .",
    "smoke": "DSH_DESKTOP_SMOKE=1 electron .",
    "icon": "node scripts/gen-icon.js && bash scripts/build-icns.sh",
    "dist": "bash scripts/build-installer.sh && electron-builder --mac dmg"
  },
  "author": "dsh-desktop",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "artifactName": "DeepSeek-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-shell.js",
      "lib/**/*",
      "renderer/**/*",
      "agent/**/*",
      "runtime/**/*",
      "assets/trayTemplate.png",
      "harness.tar"
    ],
    "asarUnpack": [
      "agent/**/*",
      "runtime/**/*",
      "assets/trayTemplate.png",
      "harness.tar"
    ],
    "electronDist": "node_modules/electron/dist",
    "afterSign": "scripts/after-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "YUANIMAL",
        "repo": "deepseek-harness-desktop",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": true
    },
    "dmg": {
      "title": "DeepSeek Desktop ${version}",
      "icon": "assets/icon.icns",
      "window": {
        "width": 560,
        "height": 400
      },
      "contents": [
        {
          "x": 130,
          "y": 160,
          "type": "file",
          "path": "assets/一键安装.app"
        },
        {
          "x": 400,
          "y": 160
        },
        {
          "x": 400,
          "y": 330,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 330,
          "type": "file",
          "path": "assets/安装说明.txt"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
